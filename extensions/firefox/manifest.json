{
  "manifest_version": 2,
  "name": "NeuroReader",
  "version": "0.1.0",
  "description": "Transform any webpage with the NeuroReader Variable Fixation Formula. Free, private — nothing leaves your browser.",
  "permissions": ["storage", "activeTab", "tabs"],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "NeuroReader"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["formula.js", "features.js", "content.js", "reading-mode.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "neuroreader@mrfentmen.github.io",
      "strict_min_version": "115.0"
    }
  }
}
