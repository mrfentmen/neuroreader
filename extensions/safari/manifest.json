{
  "manifest_version": 2,
  "name": "NeuroReader",
  "version": "0.1.0",
  "description": "Transform any webpage with the NeuroReader Variable Fixation Formula. Free, private \u2014 nothing leaves your browser.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "NeuroReader"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "formula.js",
        "features.js",
        "content.js",
        "reading-mode.js",
        "clipboard.js",
        "stats.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
