{
  "name": "neuroreader",
  "version": "0.1.0",
  "description": "A free, private reading tool for neurodivergent brains. Variable Fixation Formula — paste text, transform, read. Nothing leaves your browser.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node test/formula.test.js && node test/features.test.js && node test/adaptive.test.js",
    "test:e2e": "node test/extension.e2e.js",
    "test:webapp": "node test/webapp.e2e.js",
    "test:kids": "node test/kids.e2e.js",
    "test:api": "node test/api.test.js",
    "test:adaptive": "node test/adaptive.test.js",
    "test:adaptive-pages": "node test/adaptive-pages.e2e.js",
    "test:phase2-reading-mode": "node test/phase2-reading-mode.e2e.js",
    "test:safari-controls": "node test/safari-controls.test.js",
    "test:firefox": "node test/firefox.e2e.js",
    "test:firefox-native": "node test/firefox-native.e2e.js",
    "test:firefox-dom": "node test/firefox-dom.e2e.js",
    "check:font": ".venv/bin/python tools/validate_font.py && .venv/bin/python test/validate-all-fonts.py",
    "build:min": "node tools/minify.js web",
    "minify:ext": "node tools/minify.js ext"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "selenium-webdriver": "^4.46.0",
    "terser": "^5.49.2",
    "web-ext": "^10.6.0"
  }
}
